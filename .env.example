# Shared cache. Optional — unset means caching is disabled and every read
# goes to its source, which boots and behaves correctly, just slower.
# On Railway, provision Redis as a service in the same project and use its
# private URL. Do NOT attach a volume: the TTLs here are 2-10s, so persisting
# the cache adds nothing and risks serving stale ledger state after a restart.
# Railway's private network publishes IPv6 only, and ioredis looks up IPv4
# alone unless told otherwise — so a healthy Redis at *.railway.internal never
# resolves. The client asks for both by default; set REDIS_FAMILY=6 if
# dual-stack proves unreliable on reconnect.
# REDIS_FAMILY=
# A cache operation slower than this is abandoned. Sized for a hop inside a
# private network, not for loopback.
# REDIS_OP_TIMEOUT_MS=1000
REDIS_URL=

# Bearer token that Grafana (or any scraper) must present on GET /metrics.
# Generate with: openssl rand -hex 32
# Unset disables the endpoint entirely rather than leaving it public — the
# exposition leaks traffic shape and upstream endpoint names.
METRICS_SCRAPE_TOKEN=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stellar / Soroban
STELLAR_NETWORK=MAINNET
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Legacy single-endpoint config. Used as a fallback when
# STELLAR_RPC_ENDPOINTS is unset.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=https://horizon.stellar.org

# RPC endpoint pool, highest priority first (lower number = tried first).
# Takes precedence over STELLAR_RPC_URL when set.
# JSON array of { url, label?, priority?, authHeader? }.
#   url        - full endpoint URL. Basic-auth credentials in the URL are
#                moved into an Authorization header automatically.
#   label      - used as a metric key and in health output. Must be unique.
#   priority   - lower is tried first. Defaults to array position.
#   authHeader - "Name: value", or a bare value meaning Authorization.
#
# Endpoint URL formats:
#   Validation Cloud  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
#   OnFinality        https://stellar.api.onfinality.io/rpc
#                     + authHeader "apikey: <API_KEY>"  (keeps the key
#                     out of the URL and out of any URL logging)
#   Lightsail Quasar  https://rpc.lightsail.network        (public, no key)
#
# STELLAR_RPC_ENDPOINTS=[{"url":"https://mainnet.stellar.validationcloud.io/v1/VC_KEY","label":"validation_cloud","priority":0},{"url":"https://stellar.api.onfinality.io/rpc","label":"onfinality","priority":1,"authHeader":"apikey: ONFINALITY_KEY"},{"url":"https://rpc.lightsail.network","label":"quasar","priority":2},{"url":"https://soroban-rpc.mainnet.stellar.gateway.fm","label":"gateway_fm","priority":3}]
STELLAR_RPC_ENDPOINTS=

# CORS — comma-separated list, or a JSON array, of allowed browser origins.
# Each value is an origin (scheme + host + optional port). Empty rejects every
# browser origin.
#   CORS_ORIGIN=http://localhost:3000,https://app.nekoprotocol.xyz
#   CORS_ORIGIN=["http://localhost:3000","https://app.nekoprotocol.xyz"]
CORS_ORIGIN=http://localhost:3000

# Number of trusted reverse proxies in front of this server. The per-IP rate
# limiter and request logging both rely on this being correct.
#   0 = direct exposure / dev local (default, safe)
#   1 = one proxy hop (Vercel, Cloudflare, Railway, Fly, Nginx)
#   N = N chained proxies
# Setting it HIGHER than the real chain lets clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Shared secret for the web-app proxy (X-Internal-Key header).
INTERNAL_API_KEY=

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Vault manager secret key
VAULT_MANAGER_SECRET_KEY=

DEFINDEX_API_KEY=

# Anchor (fiat on/off-ramp) providers. Unset → that provider reports
# configured:false and its endpoints return 503 MISSING_CONFIG.
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=
ALFREDPAY_API_KEY=
ALFREDPAY_API_SECRET=
ALFREDPAY_BASE_URL=

# App origin for Supabase magic-link redirects (email verification) and the
# strategy-catalog cron. Unset → email verification returns not_configured;
# cron no-ops.
# Local: http://localhost:3000
WEB_APP_URL=
CRON_SECRET=

# Watched by the 'Admin wallet low on XLM' automation.
# Defaults to the public key of VAULT_MANAGER_SECRET_KEY.
ADMIN_WALLET_ADDRESS=

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nekoprotocol.xyz
# HMAC signing secret for mailing-automation unsubscribe links. Unset → automation emails send without an unsubscribe footer link.
MAILING_UNSUBSCRIBE_SECRET=
# ISO timestamp. Triggered emails never enroll events older than this, which
# stops a first healthy enrollment run from mailing the entire back catalogue.
# Set it to deploy time when turning automations on. Unset = enroll all history.
MAILING_ENROLLMENT_FLOOR=

# ── Launchpad onboarding (HackMeridian, testnet) ──
# Privy server SDK: creates the user + embedded Stellar wallet from an email.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Didit (use the Neko application, sandbox while testing).
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
# Launchpad origin; Didit redirects to $LAUNCHPAD_APP_URL/didit-callback.
LAUNCHPAD_APP_URL=http://localhost:3000
LAUNCHPAD_FRIENDBOT_URL=https://friendbot.stellar.org
# "true" lets judges skip Didit with a mocked, approved verification.
KYC_MOCK_ENABLED=true
